;Raquel Alfaro Barrantes, Carlos González Garita 
;Samuel Alfaro Rodríguez, Isaac Felipe Brenes Calderón

$FUN $0 args:3 parent: $0
; Cargar los valores de a, b, y c
LDV 1
BST 0 0 ; let a = 1
LDV -3
BST 0 1 ; let b = -3
LDV 2
BST 0 2 ; let c = 2
BLD 0 0
BLD 0 1
BLD 0 2
;Cargar y crear la clausura de $1
LDF $1
BST 0 3
BLD 0 3
APP 3
PRN
HLT
$END

$FUN $1 args:3 parent: $0
; Calcular el discriminante: b^2 - 4ac
BLD 0 1  ; carga b
BLD 0 1  ; carga b de nuevo
MUL      ; b * b
BLD 0 0  ; carga a
LDV 4    ; carga 4
MUL      ; 4 * a
BLD 0 2  ; carga c
MUL      ; 4 * a * c
SUB      ; b^2 - 4ac
BST 0 3  ;guardar el discriminante
; Calcular la raíz cuadrada del discriminante
BLD 0 3  ;cargar a pila discriminante
LDV 0
GTE       ;se considera si el discriminante es < 0
BF 34     ;salta a no hay solucion real
BLD 0 3   ;cargar a pila discriminante
LDV 0
EQ
BT 24    ;solo se debe calcular un caso
;calcular raiz del determinante
BLD 0 3  ;cargar a pila d (numero a quien se le va a sacar la raíz)
LDF $2
BST 0 4  ;guardar locals 
BLD 0 4
APP 1
BST 0 5  ;guardar valor de raíz  
; Calcular -b
BLD 0 1  ; carga b
NEG      ; -b
BLD 0 5
; Sumar -b y sqrt(b^2 - 4ac)
ADD      ; -b + sqrt(b^2 - 4ac)
; Calcular 2a
BLD 0 0  ; carga a
LDV 2    ; carga 2
MUL      ; 2 * a
; Dividir (-b + sqrt(b^2 - 4ac)) entre 2a
DIV      ; (-b + sqrt(b^2 - 4ac)) / (2 * a)

PRN

; Calcular -b
BLD 0 1  ; carga b
NEG      ; -b
BLD 0 5
; Sumar -b y sqrt(b^2 - 4ac)
SUB      ; -b + sqrt(b^2 - 4ac)
; Calcular 2a
BLD 0 0  ; carga a
LDV 2    ; carga 2
MUL      ; 2 * a
; Dividir (-b + sqrt(b^2 - 4ac)) entre 2a
DIV      ; (-b + sqrt(b^2 - 4ac)) / (2 * a)
BR 8

BLD 0 1  ; carga b
NEG      ; -b
BLD 0 0  ; carga a
LDV 2    ; carga 2
MUL      ; 2 * a
DIV      ; -b / (2*a)
BR 1     ;salta al return

LDV "No hay solucion real"
RET
$END

$FUN $2 args:1 parent: $1
BLD 0 0  ;cargar a pila d (numero a quien se le va a sacar la raíz)
LDV 0
EQ
BT 52    ;return d
BLD 0 0
LDV 1
EQ
BT 49     ;return d
;inicializar
BLD 0 0   
LDV 2
DIV
BST 0 1  ;guardamos el valor de root

LDV 0
BST 0 2 ;inicializamos i
BLD 0 0
LDV 2
DIV
BST 0 3 ;inicializamos x
;inicio de loop 
;Condiciones
BLD 0 2
LDV 20
LT 

BLD 0 3
BLD 0 3
MUL
BLD 0 0
SUB
BST 0 4 ;guardamos condicion por si hay que sacar valor absoluto
BLD 0 4 
LDV 0
LT
BF 4
BLD 0 4
LDV -1
MUL
BST 0 4
BLD 0 4
LDV 1e-15
GTE
AND
BF 15

BLD 0 0   
BLD 0 3
DIV
BLD 0 3
ADD
LDV 0.5
MUL
BST 0 3

BLD 0 3
BST 0 1

BLD 0 2
LDV 1
ADD
BST 0 2
BR -37

BLD 0 1
RET

BLD 0 0
RET
$END