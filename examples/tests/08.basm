$FUN $0 args:1 parent: $0
LDV 5
LDF $1
BST 0 0
BLD 0 0
APP 1
PRN
HLT
$END


$FUN $1 args:1 parent: $0
LDV 1
BST 0 1 ; inicializa resultado

LDV 1
BST 0 2  ;inicializa i

;inicio del loop
BLD 0 2 ;carga valor de i
BLD 0 0 ;carga el valor de n
LTE
BF  9   ;salir del loop
BLD 0 1
BLD 0 2
MUL
BST 0 1  ;actualiza resultado resultado *=i
LDV 1
BLD 0 2
ADD
BST 0 2 ;actualiza valor de indice i++
BR -13

BLD 0 1
RET
$END