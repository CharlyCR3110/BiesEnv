$FUN $0 args:1 parent: $0
LDV "Hola mundo"
BST 0 0
LDF $1  ; funcion encarga de contar la longitud de la hilera
BST 0 1
BLD 0 0
BLD 0 1
APP
BST 0 1 ; guarda el valor de la longitud
LDF $2  ; funcion encargada de imprimir el valor
BST 0 2
BLD 0 1
LDV 1
SUB     ; resta 1 a la longitud (para obtener el indice)
BST 0 1
BLD 0 0
BLD 0 1
BLD 0 2
APP
PRN
HLT
$END

$FUN $1 args:1 parent: $0
LDV 0
BST 0 1 ;inicializa length
LDV 1
BST 0 2 ; inicializa i

; Inicio de bucle
BLD 0 0 ;carga a pila la hilera
BLD 0 2 ;carga a pila el indice
STK     ; toma el k-ésimo elemento , basado en el indice
SNT     ;verifica que no sea null
BT +9    ;si es null, sale del loop
BLD 0 2 ;cargar el indice
LDV 1
ADD     ; se le suma 1
BST 0 2 ;actualiza el indice
BLD 0 1 ;cargar el length
LDV 1   
ADD     ;se le suma 1 al length
BST 0 1 ;actualiza el length
BR -14  ;regresa al inicio del loop

;Fin del loop
BLD 0 1  ;carga el valor del length en la pila
RET
$END

; funcion para invertir una hilera y devolverla "Hola mundo" -> "odnum aloH"
$FUN $2 args:2 parent: $0
LDV " " ; hilera vacia (para concatenar)
BST 0 5 ; guarda la hilera vacia
BLD 0 1 ; carga el length original (para iterar)
BST 0 4 ; guarda el length

; inicio del bucle
LDV -1   ; caso base, cuando i sea -1 se termina el loop
BLD 0 4 ; carga el length (en este caso el iterador)
EQ      ; verifica si i == length
BT +11  ; si i == length, sale del loop
BLD 0 5 ; carga la hilera vacia
BLD 1 0 ; carga el string original
BLD 0 4 ; carga el length
STK
CAT     ; concatena la hilera vacia con el caracter actual
BST 0 5 ; guarda la hilera concatenada
BLD 0 4 ; carga el length
LDV 1   ; 1 para restar
SUB     ; resta 1 al length
BST 0 4 ; guarda el length actualizado
BR -15  ; regresa al inicio del loop
BLD 0 5 ; carga la hilera concatenada
RET
$END