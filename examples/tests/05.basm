$FUN $0 args:1 parent: $0
LDV "Hola mundo"
BST 0 0
LDF $1  ; funcion encarga de contar la longitud de la hilera
BST 0 1
BLD 0 0
BLD 0 1
APP
BST 0 111
LDV "Hola mundo"
BST 0 110

; substring
LDV "ola"
BST 0 0
LDF $1  ; funcion encarga de contar la longitud de la hilera
BST 0 1
BLD 0 0
BLD 0 1
APP
BST 0 121
LDV "ola"
BST 0 120

LDF $2  ; funcion encargada de encontrar el indice de la subcadena
BST 0 3
BLD 0 110
BLD 0 111
BLD 0 120
BLD 0 121
BLD 0 3
APP
PRN
HLT
$END

$FUN $1 args:1 parent: $0
LDV 0
BST 0 1 ;inicializa length
LDV 1
BST 0 2 ; inicializa i

; Inicio de bucle
BLD 0 0 ;carga a pila la hilera
BLD 0 2 ;carga a pila el indice
STK     ; toma el k-ésimo elemento , basado en el indice
SNT     ;verifica que no sea null
BT +9    ;si es null, sale del loop
BLD 0 2 ;cargar el indice
LDV 1
ADD     ; se le suma 1
BST 0 2 ;actualiza el indice
BLD 0 1 ;cargar el length
LDV 1   
ADD     ;se le suma 1 al length
BST 0 1 ;actualiza el length
BR -14  ;regresa al inicio del loop

;Fin del loop
BLD 0 1  ;carga el valor del length en la pila
RET
$END

; 0 110 -> "Hola mundo"
; 0 111 -> "Hola mundo".length

; 0 120 -> "ola"
; 0 121 -> "ola".length

; 0 300 -> index of substring // -1 if not found
; 0 301 -> i

; funcion para encontrar el indice de una subcadena
$FUN $2 args:4 parent: $0
LDV -1      ; -1 significa que no se encontró la subcadena
BST 0 300   ; guarda el valor de retorno (inicialmente -1)

LDV 0       ; valor de i (iterador)
BST 0 301   ; guarda el valor de i

; Empieza el primer bucle que recorre la cadena principal
BLD 0 301   ; cargar el valor de i
BLD 0 111   ; cargar la longitud de la cadena principal
BLD 0 121   ; cargar la longitud de la subcadena
SUB         ; resta para obtener el límite (stringLength - subStringLength)
GT          ; verifica si i > (stringLength - subStringLength)
BT +31      ; salir del bucle principal si i es mayor que el límite (33 líneas hasta el final del primer bucle)

LDV 1       ; 1 si encontramos la subcadena
BST 0 400   ; found = 1

; Empieza el segundo bucle que compara los caracteres
LDV 0       ; valor de j (iterador)
BST 0 302   ; guarda el valor de j

BLD 0 121   ; cargar la longitud de la subcadena
BLD 0 302   ; cargar el valor de j
EQ          ; compara si j == subStr.length
BT +16      ; si j == subStr.length, subcadena encontrada (17 líneas hasta el final de la función)

BLD 0 110   ; carga la cadena principal
BLD 0 301   ; cargar el valor de i
BLD 0 302   ; cargar el valor de j
ADD         ; calcula el índice i + j
STK         ; obtiene string[i+j]

BLD 0 120   ; carga la subcadena
BLD 0 302   ; cargar el valor de j
STK         ; obtiene subStr[j]
EQ          ; compara string[i+j] con subStr[j]
BF +4       ; si son diferentes, salir del bucle interno (7 líneas hasta la siguiente iteración del bucle principal)

; Incrementar j
BLD 0 302   ; cargar j
LDV 1       ; sumar 1
ADD
BST 0 302   ; guardar nuevo valor de j

BLD 0 301   ; cargar i
LDV 1       ; sumar 1
ADD
BST 0 301   ; guardar nuevo valor de i

BR -33      ; regresar al inicio del bucle interno (-21 líneas hacia el inicio del segundo bucle)

; Subcadena encontrada, guardar el índice
LDV 301     ; cargar el valor de i (el índice donde comienza la subcadena)
BST 0 300   ; guardar como resultado (indice)
BLD 0 300   ; cargar el valor de retorno
RET         ; regresar, subcadena encontrada

; Salida del bucle principal, si no se encuentra la subcadena
LDV -1      ; valor de retorno -1 (no se encontró)
RET         ; regresar, subcadena no encontrada
$END