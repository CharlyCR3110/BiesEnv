;Authors:
;Raquel Alfaro Barrantes, Carlos González Garita 
;Samuel Alfaro Rodríguez, Isaac Felipe Brenes Calderón

; $0 es main
; $1 es la función factorial
;
$FUN $0 args:1 parent:$0
LDV 5         ; Cargar el valor de n (argumento de main)
LDF $1        ; Cargar la función factorial
APP           ; Aplicar factorial(n)
PRN           ; Imprimir el resultado
HLT           ; Detener la ejecución
$END
;
$FUN $1 args:1 parent:$0
BLD 0 0       ; Cargar n en la pila
LDV 0         ; Cargar 0 para comparación
EQQ           ; Verificar si n == 0
BT 9

BLD 0 0       ; Cargar n en la pila
LDV 1         ; Cargar 1
SUB           ; Calcular n - 1
CST 'string'  ; Usar la instrucción CstInstruction para convertir a string
LDF $1        ; Cargar la función factorial para llamada recursiva
APP           ; Aplicar factorial(n - 1)
BLD 0 0
MUL           ; Multiplicar n * factorial(n - 1)
RET           ; Retornar el resultado

LDV 1         ; Cargar 1 en la pila (caso base)
RET           ; Retornar 1
$END
